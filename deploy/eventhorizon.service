[Unit]
Description=eventhorizon DNS sinkhole
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/eventhorizon \
    -listen 127.0.0.1:5300 \
    -blocklist https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts \
    -log-queries blocked
# systemctl reload eventhorizon re-downloads the lists without a restart.
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure

# Run as a throwaway unprivileged user. StateDirectory creates
# /var/lib/eventhorizon for the saved list copies and passes it in
# $STATE_DIRECTORY, which eventhorizon picks up by default.
DynamicUser=yes
StateDirectory=eventhorizon

# Serving your whole network: listen on this machine's LAN address,
# port 53, e.g. "-listen 192.168.1.10:53", and point your router's DHCP
# DNS setting at that address. Port 53 needs one extra permission, which
# this line grants without running as root:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
# By default only loopback and private addresses may ask (-allow-clients),
# and each client is limited to 200 queries per second (-rate-limit).

[Install]
WantedBy=multi-user.target
